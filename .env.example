# Django settings — copy this to .env and change values
# Generate key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Production deployment updates these host settings from the entered domain or IPv4 address.
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://example.com,http://www.example.com
CORS_ALLOWED_ORIGINS=http://example.com,http://www.example.com
# IP mode example: use 203.0.113.10 in all three settings instead of the domains.

# Admin URL path (change in production to avoid scans)
ADMIN_PATH=admin/

# AI API keys (lazy-changelog uses OPENAI_API_KEY for DeepSeek via OpenAI-compatible API)
OPENAI_API_KEY=sk-your-deepseek-api-key
